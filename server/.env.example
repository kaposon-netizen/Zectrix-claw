# PocketClaw 服务端口与主机
HOST=0.0.0.0
PORT=8000
# 自动检测不正确时可设置设备可访问的局域网 IPv4 地址
# LAN_IP=192.168.1.10

# 跨 Wi-Fi / 外网移动伴学公网地址（可选）
# 如果通过 Cloudflare Tunnel、frp、DDNS 或 Tailscale Funnel 将家庭服务器映射到公网，可在此填写公网地址：
# REMOTE_URL=https://claw.yourdomain.com

# 大模型 API 配置（可选。配置后即可启用真实大模型进行事实核验、诗词解析、OCR识图与智能伴聊）
# 支持 DeepSeek / 通义千问 / OpenAI / Ollama 等任何 OpenAI 兼容格式
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
OPENAI_VISION_MODEL=gpt-4o-mini

# 可选：OpenAI 兼容语音接口；按需配置完整 URL。TTS 接口需输出 24kHz PCM。
# POCKETCLAW_STT_ENDPOINT=https://api.openai.com/v1/audio/transcriptions
# POCKETCLAW_STT_KEY=
# POCKETCLAW_STT_MODEL=whisper-1
# POCKETCLAW_TTS_ENDPOINT=https://api.openai.com/v1/audio/speech
# POCKETCLAW_TTS_KEY=
# POCKETCLAW_TTS_MODEL=tts-1
# POCKETCLAW_TTS_VOICE=alloy

# 本地设备管理令牌（独立设备管理接口使用；并非完整多租户认证）
POCKETCLAW_ADMIN_TOKEN=

# 可选火山语音；仅当对应资源已开通时生效。
VOLC_ASR_APP_ID=
VOLC_ASR_ACCESS_TOKEN=
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=
# POCKETCLAW_VOLC_ASR_RESOURCE_ID=volc.bigasr.auc_turbo
# VOLC_TTS_RESOURCE_ID=seed-tts-2.0
# VOLC_TTS_VOICE=zh_male_tiancaitongsheng_uranus_bigtts

# 实验性设备凭据校验；启用前需预注册设备并配置 WSS。
# 仅保护设备 WebSocket，不能替代尚未完成的家庭 API 权限隔离。
# POCKETCLAW_DEVICE_AUTH=required

# 家庭多租户模式：需要 HTTPS/WSS 反向代理和已创建的家庭账号。
# POCKETCLAW_MULTI_TENANT=required
# FORWARDED_ALLOW_IPS=127.0.0.1

# 可选实时语音识别，需开通相应火山流式识别资源；失败时回退整段识别。
# POCKETCLAW_VOLC_ASR_STREAMING=1
# POCKETCLAW_VOLC_STREAM_RESOURCE_ID=volc.seedasr.sauc.duration
