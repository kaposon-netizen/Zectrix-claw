/* pages/index/index.wxss */
.device-card {
  background: linear-gradient(135deg, #1e40af, #2563eb);
  border-radius: 22rpx;
  padding: 28rpx;
  color: #ffffff;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.22);
}

.device-name {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.device-sub {
  font-size: 22rpx;
  opacity: 0.9;
  margin-bottom: 16rpx;
}

.quick-mode-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.mode-chip {
  background-color: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
}

.device-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  flex-shrink: 0;
}

.battery-text {
  font-size: 22rpx;
  opacity: 0.92;
}

.star-pill {
  background-color: rgba(254, 243, 199, 0.95);
  color: #b45309;
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

/* Stat Grid */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-box {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 10rpx;
  text-align: center;
  border: 1rpx solid #e2e8f0;
}

.stat-val {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.stat-lbl {
  font-size: 20rpx;
  color: #64748b;
}

/* Focus Card */
.focus-card {
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
  border-color: #fed7aa;
}

.focus-status-tag {
  font-size: 20rpx;
  color: #c2410c;
  background-color: rgba(255, 255, 255, 0.7);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.focus-status-tag.active {
  background-color: #ea580c;
  color: #ffffff;
}

.focus-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.focus-big-time {
  font-size: 56rpx;
  font-weight: 800;
  color: #9a3412;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.focus-sub-info {
  font-size: 22rpx;
  color: #c2410c;
  margin-top: 4rpx;
}

.focus-ctrl-btns {
  display: flex;
  gap: 12rpx;
}

.btn-focus-warn {
  background-color: #ea580c;
  color: #ffffff;
}

.focus-min-row {
  display: flex;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.min-pill {
  flex: 1;
  text-align: center;
  background-color: rgba(255, 255, 255, 0.8);
  border: 1rpx solid #fdba74;
  color: #9a3412;
  font-size: 22rpx;
  font-weight: 600;
  padding: 10rpx 0;
  border-radius: 12rpx;
}

.min-pill.active {
  background-color: #ea580c;
  color: #ffffff;
  border-color: #ea580c;
}

.focus-style-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.style-chip {
  background-color: rgba(255, 255, 255, 0.85);
  border: 1rpx solid #fdba74;
  color: #9a3412;
  font-size: 22rpx;
  font-weight: 600;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
}

.style-chip.active {
  background-color: #9a3412;
  color: #ffffff;
  border-color: #9a3412;
}

.btn-start-focus {
  flex: 1;
  background-color: #ea580c;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 12rpx;
}

/* Art Horizontal Scroll */
.link-more {
  font-size: 24rpx;
  font-weight: 600;
  color: #2563eb;
}

.art-scroll {
  display: flex;
  white-space: nowrap;
  height: 310rpx;
}

.art-mini-card {
  display: inline-block;
  width: 240rpx;
  margin-right: 16rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  overflow: hidden;
  background-color: #ffffff;
  vertical-align: top;
}

.art-thumb {
  width: 240rpx;
  height: 180rpx;
  background-color: #0f172a;
  display: block;
}

.art-mini-info {
  padding: 10rpx 12rpx;
}

.art-mini-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #0f172a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.art-mini-sub {
  font-size: 20rpx;
  color: #64748b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin: 2rpx 0 8rpx 0;
}

.art-mini-btn {
  background-color: #eff6ff;
  color: #2563eb;
  font-size: 20rpx;
  font-weight: 600;
  text-align: center;
  padding: 6rpx 0;
  border-radius: 8rpx;
}

/* Nav 4x2 Grid */
.nav-grid-4 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.nav-item {
  background-color: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 18rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.nav-icon {
  font-size: 38rpx;
}

.nav-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #334155;
}

/* Timetable preview */
.courses-preview {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.course-pill {
  background-color: #f1f5f9;
  color: #334155;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.bag-note {
  font-size: 24rpx;
  color: #ea580c;
  background-color: #fff7ed;
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
}

.arrow {
  font-size: 36rpx;
  color: #94a3b8;
}

/* Idiom box */
.idiom-box {
  background-color: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 20rpx;
}

.idiom-title {
  margin-bottom: 8rpx;
}

.idiom-word {
  font-size: 32rpx;
  font-weight: 700;
  color: #2563eb;
  margin-right: 12rpx;
}

.idiom-py {
  font-size: 24rpx;
  color: #64748b;
}

.idiom-mean {
  font-size: 26rpx;
  color: #1e293b;
  line-height: 1.5;
  margin-bottom: 6rpx;
}

.idiom-ex {
  font-size: 24rpx;
  color: #ea580c;
}

/* Message pills */
.quick-msg-pills {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.msg-pill {
  background-color: #eff6ff;
  color: #2563eb;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.msg-input {
  min-height: 120rpx;
  margin-bottom: 10rpx;
}

.screen-image { display: block; width: 100%; height: 450rpx; background: #f8fafc; border: 2rpx solid #cbd5e1; border-radius: 12rpx; }
