/* pages/report/report.wxss */
.rep-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  text-align: center;
}

.rep-box {
  background-color: #f8fafc;
  border-radius: 16rpx;
  padding: 24rpx 10rpx;
  border: 1rpx solid #e2e8f0;
}

.rep-num {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.rep-lbl {
  font-size: 22rpx;
  color: #64748b;
}

.badge-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.badge-item {
  border: 1rpx solid #e2e8f0;
  background-color: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
}

.badge-item.unlocked {
  border-color: #bbf7d0;
  background-color: #f0fdf4;
}

.b-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.b-title {
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.b-desc {
  font-size: 20rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.b-status {
  font-size: 20rpx;
  font-weight: 600;
  color: #94a3b8;
}

.badge-item.unlocked .b-status {
  color: #16a34a;
}
