/* pages/habits/habits.wxss */
.habit-header {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  border-radius: 20rpx;
  padding: 32rpx;
  color: #ffffff;
  text-align: center;
  margin-bottom: 24rpx;
}

.star-badge {
  display: inline-block;
  background-color: rgba(255, 255, 255, 0.25);
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.habit-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.habit-sub {
  font-size: 22rpx;
  opacity: 0.9;
}

.icon-selector {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.icon-chip {
  background-color: #f1f5f9;
  color: #475569;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  border: 1rpx solid #e2e8f0;
}

.icon-chip.active {
  background-color: #eff6ff;
  color: #2563eb;
  border-color: #2563eb;
  font-weight: 600;
}

.add-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.habit-list {
  display: flex;
  flex-direction: column;
}

.habit-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.habit-row:last-child {
  border-bottom: none;
}

.habit-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.habit-icon {
  font-size: 32rpx;
}

.habit-info {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.habit-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.habit-name.done {
  text-decoration: line-through;
  color: #94a3b8;
}

.streak-tag {
  background-color: #fee2e2;
  color: #dc2626;
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.del-btn {
  color: #94a3b8;
  padding: 10rpx 16rpx;
  font-size: 26rpx;
}

.wish-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.wish-card {
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 18rpx;
  background-color: #ffffff;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 10rpx;
}

.wish-card.redeemed {
  background-color: #f8fafc;
  opacity: 0.7;
}

.wish-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.wish-icon {
  font-size: 36rpx;
}

.wish-cost {
  font-size: 20rpx;
  font-weight: 700;
  color: #b45309;
  background-color: #fef3c7;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.wish-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #1e293b;
  margin: 6rpx 0;
}

.wish-btn {
  background-color: #2563eb;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 10rpx;
  padding: 8rpx 0;
  margin: 0;
  line-height: 1.4;
}

.wish-need-tag {
  font-size: 20rpx;
  color: #94a3b8;
  text-align: center;
  background-color: #f1f5f9;
  border-radius: 8rpx;
  padding: 6rpx 0;
}

.wish-done-tag {
  font-size: 20rpx;
  color: #16a34a;
  text-align: center;
  background-color: #dcfce7;
  border-radius: 8rpx;
  padding: 6rpx 0;
  font-weight: 700;
}
